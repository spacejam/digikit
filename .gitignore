# Elektron firmware and anything derived from it is copyright Elektron.
# Never commit it. Users supply their own lawfully-obtained copy.
*.syx
*.zip
*_readme.html
# Your own images go in firmware/ (see firmware/README.md); only its README is committed.
/firmware/*
!/firmware/README.md
out/
venv/
__pycache__/
*.pyc
vendor/
# Firmware-derived data, never committed; it lives under out/ (sections, snapshots).
*.snap
section_*.bin
*.mstate

# uv
.venv/

# NXP reference manuals: ~11 MB of vendor PDF, plus the text dump generated
# from one of them. Fetch your own copies; the notes extracted from them
# (docs/refs/*.md) are committed and cite chapter and table numbers.
docs/refs/*.pdf
docs/refs/rm.txt
tools/coldfire/ghidra/SHARC/data/languages/*.sla
tools/coldfire/ghidra/ColdfireEMAC/data/languages/*.sla
tools/coldfire/ghidra/ColdfireEMAC/extension.properties
tools/nbdocs-scrape.py

# tools/sharc_dev/sharcspec: text extracts of the ADI manuals and generated renders and
# Ghidra language files. The PDFs themselves are covered by docs/refs/*.pdf.
docs/refs/pgr.txt
docs/refs/prm.txt
tools/sharc_dev/sharcspec/renders/
tools/sharc_dev/sharcspec/ghidra/SHARC_VISA/

# Local +Drive sample input (see docs/SAMPLES.md); never committed
samples/

# Rust build output for packages/
packages/**/target/

# JavaScript build artifacts
node_modules/
.astro/
dist/
apps/web/public/emulator-core.wasm
apps/web/public/emulator-core*.wasm
apps/web/public/patchkit.wasm
# Contains DSP code generated from firmware: never commit.
apps/web/public/emulator-core-sharc.wasm
# Directories here, symlinks in lane worktrees (tools/devtools/worktree-setup.sh): no trailing slash.
apps/web/.local
apps/web/dist
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Temporary local agent worktrees.
.claude/worktrees/
/target/
apps/web/public/modules/

# never commit: secrets, local OS files, audio, card images
.env
.env.*
*.pem
*.key
.DS_Store
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.ogg
*.img
*.img.gz
.pi/

# The owner's DX7 patch bank (not firmware): DX7-4 is generated from it.
!modules/machines/plaits/data/tyler-favorites.syx
